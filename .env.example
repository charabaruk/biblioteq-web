# Copy to .env and adjust. Use a dedicated read-only role (see docs/readonly-role.sql).
BIBLIOTEQ_DB_URL=postgresql+psycopg://biblioteq_web:change-me@localhost:5432/biblioteq
BIBLIOTEQ_DB_SCHEMA=public
BIBLIOTEQ_PAGE_SIZE=24
BIBLIOTEQ_DB_POOL_SIZE=5
BIBLIOTEQ_DB_MAX_OVERFLOW=5
BIBLIOTEQ_DB_STATEMENT_TIMEOUT_MS=5000
BIBLIOTEQ_SITE_TITLE=Library Collection
BIBLIOTEQ_LOG_LEVEL=INFO
# Set when served under a sub-path, e.g. /library
BIBLIOTEQ_ROOT_PATH=
