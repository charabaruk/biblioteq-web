{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install dependencies",
      "type": "shell",
      "command": "python3 -m venv .venv && .venv/bin/pip install -r requirements-dev.txt",
      "problemMatcher": []
    },
    {
      "label": "Dev server (reload)",
      "type": "shell",
      "command": "set -a; [ -f .env ] && . ./.env; set +a; .venv/bin/uvicorn app.main:app --reload --port 8000",
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Will watch for changes",
          "endsPattern": "Application startup complete"
        }
      }
    },
    {
      "label": "Lint",
      "type": "shell",
      "command": ".venv/bin/ruff check --output-format concise .",
      "problemMatcher": {
        "owner": "ruff",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^(.+):(\\d+):(\\d+): (\\S+) (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "code": 4,
          "message": 5
        }
      }
    },
    {
      "label": "Format",
      "type": "shell",
      "command": ".venv/bin/ruff format .",
      "problemMatcher": []
    },
    {
      "label": "Test",
      "type": "shell",
      "command": ".venv/bin/pytest -q",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Check (lint, format, test)",
      "dependsOrder": "sequence",
      "dependsOn": ["Lint", "Format", "Test"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    }
  ]
}
